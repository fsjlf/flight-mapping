# Round-trip: JFK → LHR
POST {{FlightMapping.Api_HostAddress}}/api/search
Content-Type: application/json

{
  "segments": [
    { "origin": "JFK", "destination": "LHR", "departureDate": "2026-06-15" },
    { "origin": "LHR", "destination": "JFK", "departureDate": "2026-06-22" }
  ],
  "passengers": { "adults": 1 },
  "preferences": {
    "cabin": "Economy",
    "priority": "Balanced"
  }
}

